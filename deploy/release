#!/usr/bin/env python3
import argparse, json, os, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
INTEGRATIONS = ROOT / "integrations"
CLI_RELEASE = ROOT / ".cli-release"
BUCKET = os.environ.get("TW2_RELEASES_BUCKET", "tw2-releases")
REGION = os.environ.get("AWS_REGION", "us-east-2")
PACKAGES = [
    ("claude_code", INTEGRATIONS / "claude_code" / "package.json", INTEGRATIONS / "claude_code"),
    ("codex", INTEGRATIONS / "codex" / "package.json", INTEGRATIONS / "codex"),
    ("hermes", INTEGRATIONS / "hermes" / "package.json", INTEGRATIONS / "hermes"),
    ("openclaw", INTEGRATIONS / "openclaw" / "package.json", INTEGRATIONS / "openclaw"),
]

def sh(*args, check=True, **kwargs):
    kwargs.setdefault("cwd", ROOT)
    return subprocess.run(args, text=True, check=check, **kwargs)

def out(*args):
    return sh(*args, stdout=subprocess.PIPE).stdout.strip()

def version(manifest):
    return json.loads(manifest.read_text())["version"]

def secret(name):
    return out(
        "aws", "secretsmanager", "get-secret-value",
        "--region", "us-east-2",
        "--secret-id", name,
        "--query", "SecretString",
        "--output", "text",
    )

def changed_since(tag, package_root):
    if tag is None:
        return True
    rel_package_root = str(package_root.relative_to(ROOT))
    rel_deploy = str((package_root / "deploy").relative_to(ROOT))
    return sh(
        "git", "diff", "--quiet", f"{tag}..HEAD",
        "--", rel_package_root, f":(exclude){rel_deploy}",
        check=False,
    ).returncode != 0

parser = argparse.ArgumentParser()
parser.add_argument("--first", action="store_true")
parser.add_argument("message")
args = parser.parse_args()

if out("git", "branch", "--show-current") != "main":
    raise SystemExit("deploy/release: must run from main")

cli_pointers = [
    out(
        "aws", "s3", "cp", f"s3://{BUCKET}/cli/{name}", "-",
        "--region", REGION,
    )
    for name in ("latest-mac.txt", "latest-windows.txt")
]
cli_versions = {str(Path(pointer).parent) for pointer in cli_pointers}
if len(cli_versions) != 1:
    raise SystemExit("CLI macOS and Windows artifacts must come from the same version")
cli_release = next(iter(cli_versions))
previous_cli_release = CLI_RELEASE.read_text().strip() if CLI_RELEASE.is_file() else None
cli_changed = cli_release != previous_cli_release
if cli_changed:
    CLI_RELEASE.write_text(f"{cli_release}\n")

sh("git", "add", ".")
if out("git", "status", "--porcelain"):
    sh("git", "commit", "-m", args.message)
    sh("git", "push", "origin", "main")
else:
    print("No source changes to commit")

for name, manifest, package_root in PACKAGES:
    tag = (out("git", "tag", "--list", f"{name}/v*", "--sort=-v:refname").splitlines() or [None])[0]
    if not cli_changed and not changed_since(tag, package_root):
        print(f"Skipping {name}: no changes since {tag}")
        continue

    old = version(manifest)
    cmd = [sys.executable, str(package_root / "deploy" / "release")]
    if args.first or tag is None:
        cmd.append("--first")

    env = os.environ.copy()
    env["NODE_AUTH_TOKEN"] = secret("package-manager-tokens/npm")
    print(f"Publishing {name} from {tag or 'no previous tag'}")
    released = sh(*cmd, cwd=package_root, env=env, check=False)
    if released.returncode:
        raise SystemExit(f"{name} release stopped. Resolve the message above and run it again.")

    new = version(manifest)
    if name in ("claude_code", "codex"):
        marketplace = (
            ROOT / ".claude-plugin" / "marketplace.json"
            if name == "claude_code"
            else ROOT / ".agents" / "plugins" / "marketplace.json"
        )
        catalog = json.loads(marketplace.read_text())
        catalog["plugins"][0]["source"]["version"] = new
        marketplace.write_text(json.dumps(catalog, indent=2) + "\n")
        sh("git", "add", str(marketplace.relative_to(ROOT)))
    if sh("git", "diff", "--quiet", "--", str(manifest.relative_to(ROOT)), check=False).returncode:
        sh("git", "add", str(package_root.relative_to(ROOT)))
        sh("git", "commit", "-m", f"Release {name} v{new}")
    sh("git", "tag", f"{name}/v{new}")
    print(f"Published {name} {old} -> {new}")

sh("git", "push", "origin", "main", "--tags")
