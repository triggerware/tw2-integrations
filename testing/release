#!/usr/bin/env bash
set -euo pipefail

testing=$(cd "$(dirname "$0")" && pwd)
workspace=$(dirname "$testing")
marketplace="$workspace"
cd "$workspace"

source "$testing/common.sh"

case "${1:-} ${2:-}" in
  "codex install")
    run_codex plugin remove triggerware@triggerware 2>/dev/null || true
    run_codex plugin marketplace remove triggerware 2>/dev/null || true
    run_codex plugin marketplace add "$marketplace"
    run_codex plugin add triggerware@triggerware
    ;;
  "codex uninstall")
    run_codex plugin remove triggerware@triggerware
    run_codex plugin marketplace remove triggerware
    ;;
  "claude install")
    claude plugin marketplace add "$marketplace"
    claude plugin install triggerware@triggerware
    ;;
  "claude uninstall")
    claude plugin uninstall triggerware@triggerware
    claude plugin marketplace remove triggerware
    ;;
  "hermes install")
    hermes mcp add triggerware --command npx --args -y @triggerware/hermes@latest mcp
    ;;
  "hermes uninstall")
    hermes mcp remove triggerware
    ;;
  "openclaw install")
    openclaw plugins install @triggerware/openclaw@latest
    ;;
  "openclaw uninstall")
    openclaw plugins uninstall triggerware
    ;;
  *)
    echo "Usage: $0 {codex|claude|hermes|openclaw} {install|uninstall}" >&2
    exit 2
    ;;
esac
